# This lean stack has no required secrets. Add Label Studio authentication and
# an external database before exposing it beyond localhost.
WORKBENCH_ROOT=/workbench

# Label Studio ML backend. Use OpenAI directly or an OpenAI-compatible LiteLLM proxy.
# Leave MODEL_BASE_URL empty to use the provider default.
MODEL_VERSION=multimodal-responses-presidio-v1
MODEL_ENABLED=false
MODEL_PROVIDER=openai
MODEL_BASE_URL=
MODEL_API_KEY=
OPENAI_API_KEY=
LITELLM_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_OUTPUT_TOKENS=128
# Leave empty for model defaults; set 0 only when the selected model supports it.
MODEL_TEMPERATURE=

# Raw candidate text is redacted before the model call unless explicitly enabled.
MODEL_SEND_PII=false
# Presidio cannot redact image pixels, so image forwarding requires a separate opt-in.
MODEL_SEND_IMAGES=false
MODEL_IMAGE_DETAIL=auto
MODEL_MAX_IMAGES=4
PRESIDIO_ENABLED=true
PRESIDIO_LANGUAGE=en
PRESIDIO_SCORE_THRESHOLD=0.5
PRESIDIO_TIMEOUT_SECONDS=10
PII_FAIL_CLOSED=true
